# Copy this file to .env and fill in real values before running in production.

# Local dev default is SQLite so you can run this with zero setup.
# For real use, point this at Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/ledger
DATABASE_URL=sqlite:///./ledger.db

# Generate a real secret with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of origins allowed to call this API (your web/mobile dev URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006
